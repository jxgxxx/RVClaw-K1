# Path-only switch; original policies and units are retained.
[Unit]
Description=RVClaw persistent navigation runtime (STM32, lidar, localization, Nav2)
After=default.target
StartLimitIntervalSec=600
StartLimitBurst=3
RequiresMountsFor=@ROBOT_ROOT@ /data/spacemit_robot @ROBOT_ROOT@
[Service]
CPUAffinity=0-6
Type=simple
KillMode=control-group
EnvironmentFile=@ROBOT_ROOT@/runtime/k1/environment/rvclaw-nav2-persistent.service.env
WorkingDirectory=@ROBOT_ROOT@/runtime/k1/navigation
ExecStart=@ROBOT_ROOT@/deploy/k1/with_device_groups.sh /bin/bash @ROBOT_ROOT@/runtime/k1/navigation/scripts/nav2_persistent_runtime.sh --run
ExecStartPre=/bin/sleep 20
Restart=on-failure
RestartSec=30
TimeoutStartSec=300
TimeoutStopSec=30
KillSignal=SIGINT
SuccessExitStatus=SIGINT 130

[Install]
WantedBy=default.target
