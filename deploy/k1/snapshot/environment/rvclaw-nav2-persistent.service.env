ROS_LOCALHOST_ONLY="1"
RVCLAW_NAV_GRAPH_QUERY_TIMEOUT_S="15"
RVCLAW_LIDAR_MOTOR_CONTROL_TIMEOUT_S="20"
RVCLAW_LAB_ROOT="@ROBOT_ROOT@/runtime/k1/navigation"
RVCLAW_BASE_ROOT="@ROBOT_ROOT@/runtime/k1/base"
RVCLAW_AUTO_RVIZ="false"
RVCLAW_FRONT_SCAN_HALF_ANGLE_DEG="70.0"
RVCLAW_LOCALIZATION_SCAN_HALF_ANGLE_DEG="180.0"
RVCLAW_LOCALIZATION_MIN_RANGE_M="0.35"
RVCLAW_LIDAR_SYSROOT="/"
RVCLAW_LIDAR_LIB_DIR="/usr/lib/riscv64-linux-gnu"
RVCLAW_MAP_FILE="@ROBOT_ROOT@/configs/scenes/inspection-k1-reviewed/map.yaml"
RVCLAW_LOCALIZATION_CACHE="@ROBOT_ROOT@/runtime/k1/scenes/inspection-k1-reviewed/localization-pose.json"

RVCLAW_HARDWARE_NODE_PREFIX="@ROBOT_ROOT@/deploy/k1/run_control_process.sh"

RMW_IMPLEMENTATION="rmw_cyclonedds_cpp"
CYCLONEDDS_URI="file://@ROBOT_ROOT@/deploy/k1/env/cyclonedds.xml"
LD_LIBRARY_PATH="@ROBOT_ROOT@/runtime/k1/ros-middleware/opt/ros/humble/lib:@ROBOT_ROOT@/runtime/k1/ros-middleware/opt/ros/humble/lib/riscv64-linux-gnu:/opt/ros/humble/lib"

RVCLAW_MAP_KERNEL_LIBRARY="@ROBOT_ROOT@/deploy/k1/compatibility/scan_map_kernel.so"
RVCLAW_STATE_PUBLISH_RATE_HZ="5.0"

RVCLAW_ODOM_RELIABLE="1"
