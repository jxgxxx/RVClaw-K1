{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RVClaw Cloud Meter Candidate",
  "description": "One image candidate, not a route consensus or alarm result.",
  "type": "object",
  "required": ["status", "value", "confidence", "elapsed_ms"],
  "properties": {
    "status": {"enum": ["stable", "unreadable", "low_confidence", "inference_offline", "inference_error"]},
    "kind": {"enum": ["digital", "pointer"]},
    "value": {"type": ["number", "null"]},
    "raw_text": {"type": ["string", "null"]},
    "unit": {"type": ["string", "null"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "angle_deg": {"type": ["number", "null"]},
    "reason": {"type": "string"},
    "model": {"type": "string"},
    "value_method": {"const": "cloud_vision_chat_completions"},
    "candidate_value": {"type": "number"},
    "candidate_raw_text": {"type": "string"},
    "elapsed_ms": {"type": "number", "minimum": 0}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "stable"}}},
     "then": {"properties": {"value": {"type": "number"}}},
     "else": {"properties": {"value": {"type": "null"}}}}
  ]
}
