# Used by the independent cloud CLI and the optional route assistance module.
# Cloud starts only after a rejected local reading; no extra resident model.
RVCLAW_METER_CLOUD_ENABLED=1
RVCLAW_METER_CLOUD_BASE_URL=https://api.labhuan.com/v1
RVCLAW_METER_CLOUD_MODEL=deepseek-v4-flash
RVCLAW_METER_CLOUD_TIMEOUT=45
RVCLAW_METER_MIN_CONFIDENCE=0.70
RVCLAW_METER_API_KEY_FILE=/data/RVClaw/runtime/k1/secrets/meter_cloud_api_key
RVCLAW_METER_CLOUD_THINKING=disabled
RVCLAW_METER_CLOUD_MAX_TOKENS=512
RVCLAW_METER_HYBRID_ENABLED=1
RVCLAW_METER_HYBRID_BUDGET_S=30
RVCLAW_METER_HYBRID_FINAL_WAIT_S=8
RVCLAW_METER_HYBRID_REQUEST_TIMEOUT_S=20
